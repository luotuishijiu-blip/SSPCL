<local:MyPageRight x:Class="PageStarsectorDownload"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Sspcl" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel Margin="25,25,25,10">
            <local:MyCard Title="MOD 商店" Margin="0,0,0,15">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock Text="完整 MOD 可下载到 MOD 池，在版本设置中启用。补丁和附加文件请保存压缩包，按发布帖说明安装。" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray3}"/>
                    <Button x:Name="BtnImportArchive" Content="导入已下载压缩包" HorizontalAlignment="Left" Padding="12,6" Margin="0,10,0,0" ToolTip="选择 ZIP、RAR 或 7z，可多选；安装到 MOD 池，同 ID 的旧版会更新，原压缩包保留" Click="ImportArchive_Click"/>
                    <TextBlock x:Name="LabCache" Text="正在读取本地目录…" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                    <TextBlock Text="搜索名称、作者、MOD ID 或简介" Margin="0,10,0,0"/>
                    <DockPanel Margin="0,12,0,8">
                        <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="刷新目录" ToolTip="更新 MOD 目录；短时间重复刷新会使用缓存" Padding="12,4" Margin="8,0,0,0" Click="Refresh_Click"/>
                        <TextBox x:Name="BoxSearch" Padding="8,5" ToolTip="搜索 MOD 名称、ID、作者或简介" TextChanged="Filter_Changed"/>
                    </DockPanel>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="BoxVersion" Padding="6,4" Margin="0,0,6,0" ToolTip="游戏版本" SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="BoxCategory" Grid.Column="1" Padding="6,4" Margin="0,0,6,0" ToolTip="MOD 分类" SelectionChanged="Filter_Changed"/>
                        <ComboBox x:Name="BoxLanguage" Grid.Column="2" Padding="6,4" ToolTip="语言" SelectionChanged="Filter_Changed"/>
                    </Grid>
                    <DockPanel Margin="0,0,0,10">
                        <ComboBox x:Name="BoxSort" DockPanel.Dock="Right" Width="130" SelectedIndex="0" ToolTip="排序" SelectionChanged="Filter_Changed"><ComboBoxItem Content="最新更新"/><ComboBoxItem Content="名称排序"/></ComboBox>
                        <CheckBox x:Name="CheckDirect" Content="仅显示可直接下载" VerticalAlignment="Center" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
                    </DockPanel>
                    <TextBlock x:Name="LabCount" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,0,0,6"/>
                    <TextBlock x:Name="LabEmpty" Text="暂无匹配的 MOD。请调整搜索或筛选；首次加载失败时可稍后刷新。" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,6"/>
                    <ListBox x:Name="ModList" Height="230" SelectionChanged="Mod_Selected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="6,5">
                                    <TextBlock Text="{Binding ChineseName}" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}"/>
                                    <TextBlock Foreground="{DynamicResource ColorBrushGray3}"><Run Text="{Binding Id}"/><Run Text=" · "/><Run Text="{Binding Version}"/></TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="MOD 详情与发布包" Margin="0,0,0,15">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock x:Name="LabName" Text="选择一个 MOD 查看详情" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush1}"/>
                    <TextBlock x:Name="LabInfo" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                    <TextBlock x:Name="LabDescription" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock x:Name="LabDependencies" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                    <TextBlock x:Name="LabNotes" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                    <ComboBox x:Name="BoxRelease" Margin="0,12,0,0" Padding="6,5" DisplayMemberPath="Display" SelectionChanged="Release_Selected"/>
                    <TextBlock x:Name="LabDownloadHint" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                    <WrapPanel Margin="0,10,0,0">
                        <Button x:Name="BtnDownload" Content="下载到 MOD 池" IsEnabled="False" Padding="12,6" Click="Download_Click"/>
                        <Button x:Name="BtnSaveArchive" Content="保存压缩包" IsEnabled="False" Padding="12,6" Margin="8,0,0,0" Click="SaveArchive_Click"/>
                        <Button x:Name="BtnForum" Content="打开发布帖" IsEnabled="False" Padding="12,6" Margin="8,0,0,0" Click="Forum_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="LabStatus" Text="请选择 MOD 查看详情。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                </StackPanel>
            </local:MyCard>
            <local:MyCard Title="下载与导入任务" Margin="0,0,0,15">
                <StackPanel Margin="20,38,20,18">
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="清除已结束任务" Click="ClearTasks_Click" Padding="8,4" ToolTip="尚未保存的附件也会清理"/>
                        <TextBlock x:Name="LabTasks" Text="最多同时下载 3 项；下载时可以继续浏览目录。" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </DockPanel>
                    <ItemsControl x:Name="TaskList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource ColorBrushGray3}" BorderThickness="0,0,0,1" Padding="0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <DockPanel Margin="0,4,0,0">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="保存附件" IsEnabled="{Binding CanSave}" Click="SaveTask_Click" Margin="8,0,0,0" Padding="8,3"/>
                                                <Button Content="取消" IsEnabled="{Binding CanCancel}" Click="CancelTask_Click" Margin="8,0,0,0" Padding="8,3"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <ProgressBar Value="{Binding Percent}" IsIndeterminate="{Binding Indeterminate}" Maximum="100" Height="5" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
