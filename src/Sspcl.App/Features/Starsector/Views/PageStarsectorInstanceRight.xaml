<local:MyPageRight x:Class="PageStarsectorInstanceRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sspcl" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <!-- 内存分配 -->
            <StackPanel x:Name="PanMemory" Visibility="Collapsed">
                <local:MyCard Title="内存分配" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <local:MyCheckBox x:Name="ChkFollowGlobal" Text="跟随全局设置（使用 设置 → 启动 中的内存分配）" Margin="0,0,0,12"/>
                        <StackPanel x:Name="PanMemManual" Orientation="Horizontal">
                            <TextBlock Text="Xmx" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <local:MyTextBox x:Name="BoxXmx" Width="100" Margin="8,0,0,0"/>
                            <TextBlock Text="Xms" VerticalAlignment="Center" Margin="20,0,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <local:MyTextBox x:Name="BoxXms" Width="100" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LabMemHint" FontSize="12" Foreground="{DynamicResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,10,0,0" Text="保存后写入 vmparams 文件，下次启动生效。"/>
                        <local:MyButton x:Name="BtnSaveMem" Text="保存" Padding="14,6" Margin="0,15,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <!-- 概览 -->
            <StackPanel x:Name="PanOverview" Visibility="Collapsed">
                <local:MyCard Title="概览" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock x:Name="LabOverview" FontSize="13" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" Text="正在读取……"/>
                        <TextBlock x:Name="LabOverviewMemory" FontSize="13" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" Margin="0,12,0,0" Text="正在读取内存信息…"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <!-- Mod 管理 -->
            <StackPanel x:Name="PanMod" Visibility="Collapsed">
                <local:MyCard Title="Mod 管理" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock x:Name="LabModSummary" FontSize="13" Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" Text="正在扫描……"/>
                        <WrapPanel Margin="0,12,0,8">
                            <Button x:Name="BtnSaveMods" Padding="14,8" Margin="0,0,8,0" Background="#2866DB" Click="SaveMods"><TextBlock Text="保存启用方案" Foreground="White"/></Button>
                            <Button Content="全选" Padding="12,8" Margin="0,0,8,0" Click="SelectAllMods"/>
                            <Button Content="全部取消" Padding="12,8" Margin="0,0,8,0" Click="ClearAllMods"/>
                            <Button x:Name="BtnRescan" Content="重新扫描" Padding="12,8" Margin="0,0,8,0" Click="RescanMods"/>
                            <Button Content="选择 MOD 集文件夹" Padding="12,8" Click="SelectModsFolder"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="检查可用更新" Padding="10,6" Margin="0,0,8,4" Click="CheckUpdates_Click" x:Name="BtnCheckUpdates"/>
                            <Button Content="启动诊断" Padding="10,6" Margin="0,0,8,4" Click="Diagnostics_Click"/>
                            <Button Content="备份管理" Padding="10,6" Margin="0,0,8,4" Click="Backups_Click"/>
                        </WrapPanel>
                        <WrapPanel>
                            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,4"/>
                            <TextBox x:Name="BoxModSearch" Width="210" Padding="7,5" Margin="0,0,8,4" TextChanged="SearchMods_Changed" ToolTip="搜索名字、ID、作者或文件夹"/>
                            <ComboBox x:Name="FilterModStatus" Width="120" SelectedIndex="0" Margin="0,0,8,4" Padding="5" SelectionChanged="FilterMods_Changed">
                                <ComboBoxItem Content="全部 MOD" Tag="all"/><ComboBoxItem Content="已启用" Tag="enabled"/><ComboBoxItem Content="未启用" Tag="disabled"/><ComboBoxItem Content="缺失" Tag="missing"/><ComboBoxItem Content="可更新" Tag="updates"/>
                            </ComboBox>
                            <ComboBox x:Name="FilterModAuthor" Width="160" Margin="0,0,8,4" Padding="5" SelectionChanged="FilterMods_Changed" ToolTip="按作者筛选"/>
                        </WrapPanel>
                        <TextBlock x:Name="LabModResults" Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" FontSize="12" Text="全选与全部取消作用于完整清单。"/>
                        <Button x:Name="BtnCancelUpdate" Content="取消更新下载" Visibility="Collapsed" Padding="12,6" Margin="0,8,0,0" HorizontalAlignment="Left" Click="CancelUpdate_Click"/>
                        <ListBox x:Name="PanModList" Height="440" Margin="0,8,0,0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                          <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                          <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="论坛更新" Tag="{Binding Mod}" Click="OnlineUpdate_Click" Padding="6,3"/><Button Content="本地更新" Tag="{Binding Mod}" Click="LocalUpdate_Click" Padding="6,3" Margin="4,0,0,0"/></StackPanel>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" HorizontalContentAlignment="Stretch" ToolTip="{Binding Details}"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/></CheckBox>
                          </DockPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <!-- 导出 -->
            <StackPanel x:Name="PanExport" Visibility="Collapsed">
                <local:MyCard Title="导出" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock FontSize="13" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" Text="把当前已启用的 mod id 列表复制到剪贴板，便于分享或备份。"/>
                        <local:MyButton x:Name="BtnExportClip" Text="复制 mod id 列表" Padding="14,6" Margin="0,15,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <!-- settings 文件 -->
            <StackPanel x:Name="PanSettings" Visibility="Collapsed">
                <local:MyCard Title="settings 文件" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBox x:Name="BoxSettingsJson" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto"
                                 Height="300" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <local:MyButton x:Name="BtnSaveSettings" Text="保存" Padding="14,6"/>
                            <local:MyButton x:Name="BtnReloadSettings" Text="重新读取" Padding="14,6" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LabSettingsHint" FontSize="12" Foreground="{DynamicResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,10,0,0" Text="直接编辑 settings.json 原始内容。"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
