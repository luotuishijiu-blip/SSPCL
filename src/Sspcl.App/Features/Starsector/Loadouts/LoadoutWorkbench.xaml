<Window x:Class="LoadoutWorkbench"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SSPCL · 舰船装配工坊" Width="1380" Height="940" MinWidth="1080" MinHeight="820"
 WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Microsoft YaHei UI" Foreground="#23324A">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#23324A"/>
   <Setter Property="BorderBrush" Value="#DCE4EE"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
     <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.75"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,7"/><Setter Property="BorderBrush" Value="#DCE4EE"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#23324A"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="8,9"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
  <Style TargetType="DataGrid"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="CanUserDeleteRows" Value="False"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="Horizontal"/><Setter Property="RowBackground" Value="White"/><Setter Property="AlternatingRowBackground" Value="#F5F8FC"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Padding" Value="10,8"/><Setter Property="Foreground" Value="#23324A"/></Style>
 </Window.Resources>
 <Grid Margin="22" Background="#F3F6FA">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18"><StackPanel><TextBlock Text="舰船装配工坊" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="选择舰船 · 点击槽位装配 · 生成建议 · 导出游戏配置" Foreground="#73839B" Margin="0,5,0,0"/></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="BtnReload" Content="重载游戏数据"/><Button x:Name="BtnApiSettings" Content="AI 设置" Margin="0"/></StackPanel>
  </Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <WrapPanel><Button x:Name="BtnToggleHulls" Content="收起目录"/><ComboBox x:Name="BoxStyle" SelectedIndex="0" Width="95" VerticalContentAlignment="Center" Margin="0,0,12,0"><ComboBoxItem Content="均衡"/><ComboBoxItem Content="远程"/><ComboBoxItem Content="突击"/><ComboBoxItem Content="防御"/></ComboBox>
     <Button x:Name="BtnGenerate" Content="智能规则装配" Background="#2866DB" Foreground="White" BorderBrush="#2866DB"/>
     <Button x:Name="BtnAi" Content="AI 建议"/><Button x:Name="BtnCancel" Content="取消生成" Visibility="Collapsed"/>
     <Button x:Name="BtnUndo" Content="撤销"/><Button x:Name="BtnRedo" Content="重做"/>
    </WrapPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="BtnImport" Content="导入 .variant"/><Button x:Name="BtnExport" Content="导出 .variant" Margin="0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="2">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="HullColumn" Width="225" MinWidth="170" MaxWidth="420"/><ColumnDefinition x:Name="HullSplitColumn" Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
   <Border x:Name="HullSidebar" Background="White" CornerRadius="10" Padding="12">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="舰船目录" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10"/>
     <TextBox Grid.Row="1" x:Name="BoxHullSearch" ToolTip="按名称、ID 或来源筛选" Margin="0,0,0,8"/>
     <ListBox Grid.Row="2" x:Name="HullList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock Text="{Binding Source}" FontSize="11" Foreground="#73839B" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="3" x:Name="LabCatalog" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </Grid>
   </Border>
   <GridSplitter x:Name="HullSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D8E2EE" Cursor="SizeWE" ToolTip="左右拖动调整目录宽度；拖到最窄可收起"/>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#101C30" CornerRadius="10" ClipToBounds="True">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="18,15"><StackPanel><TextBlock x:Name="LabHull" Text="选择一艘舰船" Foreground="White" FontSize="19" FontWeight="SemiBold"/><TextBlock x:Name="LabHullDetail" Foreground="#99ADC8" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button x:Name="BtnFit" Content="适应画布" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0" Background="#223650" Foreground="White" BorderBrush="#314765"/></Grid>
      <Grid Grid.Row="1" x:Name="PreviewHost" Background="Transparent" ClipToBounds="True">
       <Viewbox x:Name="PreviewBox" Margin="18" Stretch="Uniform"><Canvas x:Name="ShipCanvas" Width="400" Height="400"/></Viewbox>
       <TextBlock x:Name="LabSprite" Text="正在读取当前游戏与启用的 MOD…" Foreground="#99ADC8" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="350" IsHitTestVisible="False"/>
      </Grid>
      <StackPanel Grid.Row="2" Margin="18,12" Orientation="Horizontal"><TextBlock Text="● 弹道" Foreground="#FFC86A" Margin="0,0,12,0"/><TextBlock Text="● 能量" Foreground="#72C7FF" Margin="0,0,12,0"/><TextBlock Text="● 导弹" Foreground="#F6A2CF" Margin="0,0,12,0"/><TextBlock Text="● 混合" Foreground="#85DFBC"/></StackPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="14" Margin="0,12,0,0">
     <StackPanel><Grid><TextBlock x:Name="LabBudget" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="LabFlux" Foreground="#73839B" HorizontalAlignment="Right"/></Grid>
      <ProgressBar x:Name="OpBar" Height="5" Margin="0,10,0,10" Foreground="#2866DB" Background="#E7EDF6"/>
      <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Border Background="#EFF5FF" CornerRadius="7" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="总护盾伤害 / 秒" Foreground="#73839B" FontSize="11"/><TextBlock x:Name="LabShieldDps" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#2866DB"/></StackPanel></Border>
       <Border Grid.Column="1" Background="#FFF5E9" CornerRadius="7" Padding="8" Margin="0,0,6,0"><StackPanel><TextBlock Text="总装甲伤害 / 秒" Foreground="#73839B" FontSize="11"/><TextBlock x:Name="LabArmorDps" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#AE6A24"/></StackPanel></Border>
       <Border Grid.Column="2" Background="#EDF8F3" CornerRadius="7" Padding="8"><StackPanel><TextBlock Text="总结构伤害 / 秒" Foreground="#73839B" FontSize="11"/><TextBlock x:Name="LabHullDps" Text="0" FontSize="20" FontWeight="SemiBold" Foreground="#248362"/></StackPanel></Border>
      </Grid>
      <TextBlock x:Name="LabDamageBasis" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="LabHullStats" FontSize="12" Foreground="#23324A" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <WrapPanel><TextBlock Text="配置名" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="BoxName" Width="160" Text="SSPCL 配装"/><TextBlock Text="通风" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox x:Name="BoxVents" Width="44" Text="0"/><TextBlock Text="电容" VerticalAlignment="Center" Margin="10,0,6,0"/><TextBox x:Name="BoxCaps" Width="44" Text="0"/></WrapPanel>
      <TextBlock x:Name="LabExplanation" Text="手工安装会锁定槽位，生成建议时保留。滚轮缩放，中键拖动画布。" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="34" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
     </StackPanel>
    </Border>
   </Grid>
   <Border Grid.Column="4" Background="White" CornerRadius="10" Padding="12">
    <TabControl x:Name="DetailTabs" BorderThickness="0" Background="White">
     <TabItem Header="武器装配"><Grid Margin="0,8,0,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="140"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="槽位与武器" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ListBox Grid.Row="1" x:Name="SlotList" FontSize="11"/>
     <StackPanel Grid.Row="2" Margin="0,12,0,8"><TextBlock x:Name="LabSlot" Text="点击舰船上的圆点选择槽位" FontWeight="SemiBold" TextWrapping="Wrap"/><CheckBox x:Name="CheckPin" Content="锁定此槽位（生成时保留）" Margin="0,8,0,0"/></StackPanel>
     <TextBox Grid.Row="3" x:Name="BoxWeaponSearch" ToolTip="搜索兼容武器；双击安装" Margin="0,0,0,8"/>
     <ListBox Grid.Row="4" x:Name="WeaponList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Display}" FontSize="10" Foreground="#73839B" TextWrapping="Wrap" Margin="0,3,0,0"/><TextBlock Text="{Binding Source}" Foreground="#73839B" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     <TextBlock Grid.Row="5" x:Name="LabWeapon" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,8"/>
     <StackPanel Grid.Row="6" Orientation="Horizontal"><Button x:Name="BtnInstall" Content="安装武器" Background="#2866DB" Foreground="White" BorderBrush="#2866DB"/><Button x:Name="BtnClear" Content="清空槽位" Margin="0"/></StackPanel>
    </Grid>
     </Grid></TabItem>
     <TabItem Header="武器详解"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="4,12,4,8">
      <TextBlock x:Name="LabWeaponTitle" Text="先在武器装配中选择武器" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock x:Name="LabWeaponOverview" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <TextBlock Text="详细描述" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <TextBox x:Name="BoxWeaponDescription" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Padding="0" Background="Transparent"/>
      <TextBlock Text="全部数据表参数" FontWeight="SemiBold" Margin="0,18,0,8"/>
      <ItemsControl x:Name="WeaponParameterList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock Text="{Binding Name}" Foreground="#73839B" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Expander Header="完整武器规格（含动画与射击参数）" Margin="0,16,0,0"><TextBox x:Name="BoxWeaponSpec" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
      <Expander Header="完整弹体规格" Margin="0,12,0,0"><TextBox x:Name="BoxProjectileSpec" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="320" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/></Expander>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="船插"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="145"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="普通船插占用 OP；内置/S 插不设数量上限。玩家决定添加，不自动限制适用性或冲突。" TextWrapping="Wrap" FontSize="11" Foreground="#73839B" Margin="0,0,0,8"/>
      <TextBox Grid.Row="1" x:Name="BoxHullModSearch" ToolTip="搜索所有原版与已启用 MOD 船插" Margin="0,0,0,8"/>
      <ListBox Grid.Row="2" x:Name="HullModList"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" FontSize="11" Foreground="#73839B"/><TextBlock Text="{Binding Source}" FontSize="10" Foreground="#73839B" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <ScrollViewer Grid.Row="3" MaxHeight="145" VerticalScrollBarVisibility="Auto" Margin="0,8"><TextBlock x:Name="LabHullModDescription" Text="选择船插查看说明与当前舰型 OP。" TextWrapping="Wrap" FontSize="11"/></ScrollViewer>
      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="BtnHullModNormal" Content="普通安装" Padding="9,7"/><Button x:Name="BtnHullModBuiltIn" Content="内置/S 插" Padding="9,7"/><Button x:Name="BtnHullModRemove" Content="移除" Padding="9,7" Margin="0"/></StackPanel>
      <ListBox Grid.Row="5" x:Name="InstalledHullModList" FontSize="11"/>
      <TextBlock Grid.Row="6" x:Name="LabHullModCount" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </Grid></TabItem>
     <TabItem Header="舰船数据"><Grid Margin="0,10,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="船体基础数据（含皮肤覆盖）。船插、技能及 MOD 动态脚本的实战修正由游戏计算；下方保留全部源参数。" Foreground="#73839B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
       <TextBlock x:Name="LabHullDescription" TextWrapping="Wrap" Margin="0,0,0,12"/>
       <ItemsControl x:Name="HullParameterList"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock Text="{Binding Name}" FontSize="11" Foreground="#73839B" TextWrapping="Wrap"/><TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
       <Expander Header="完整船体/皮肤规格" Margin="0,12,0,0"><TextBox x:Name="BoxHullSpec" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="320" FontFamily="Consolas" FontSize="11"/></Expander>
      </StackPanel></ScrollViewer>
     </Grid></TabItem>
    </TabControl>
   </Border>
  </Grid>
  <TextBlock Grid.Row="3" x:Name="LabStatus" Text="准备读取游戏数据…" Foreground="#73839B" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</Window>
