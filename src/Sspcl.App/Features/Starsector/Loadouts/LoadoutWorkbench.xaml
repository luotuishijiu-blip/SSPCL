<Window x:Class="LoadoutWorkbench" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SSPCL · 舰船装配工坊" Width="1380" Height="940" MinWidth="900" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#F3F6FA" FontFamily="Microsoft YaHei UI" FontSize="12" Foreground="#23324A">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#23324A" />
      <Setter Property="BorderBrush" Value="#DCE4EE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Frame" CornerRadius="7" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
              <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Frame" Property="Opacity" Value="0.75" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Frame" Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="BorderBrush" Value="#DCE4EE" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#23324A" />
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="CanUserDeleteRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="RowBackground" Value="White" />
      <Setter Property="AlternatingRowBackground" Value="#F5F8FC" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="8,5" />
      <Setter Property="Foreground" Value="#23324A" />
    </Style>
    <Style xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="WeaponRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
 <EventSetter Event="MouseEnter" Handler="WeaponHovered" /><EventSetter Event="MouseLeave" Handler="WeaponLeft" /><EventSetter Event="PreviewMouseRightButtonDown" Handler="WeaponRightClicked" />
</Style>
  </Window.Resources>
  <Grid Margin="12" Background="#F3F6FA">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,8" LastChildFill="False">
      <TextBlock Text="装配工坊" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button x:Name="BtnToggleHulls" Content="收起目录" />
      <ComboBox x:Name="BoxStyle" SelectedIndex="0" Width="72" VerticalContentAlignment="Center" Margin="0,0,8,0">
        <ComboBoxItem Content="均衡" />
        <ComboBoxItem Content="远程" />
        <ComboBoxItem Content="突击" />
        <ComboBoxItem Content="防御" />
      </ComboBox>
      <Button x:Name="BtnGenerate" Content="规则装配" Background="#2866DB" Foreground="White" />
      <Button x:Name="BtnAi" Content="AI 建议" />
      <Button x:Name="BtnCancel" Content="取消" Visibility="Collapsed" />
      <Button x:Name="BtnUndo" Content="撤销" />
      <Button x:Name="BtnRedo" Content="重做" />
      <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
        <MenuItem Header="设置">
          <MenuItem x:Name="BtnReload" Header="重载游戏数据" />
          <MenuItem x:Name="BtnApiSettings" Header="AI 设置" />
        </MenuItem>
      </Menu>
      <Button DockPanel.Dock="Right" x:Name="BtnExport" Content="导出 .variant" />
      <Button DockPanel.Dock="Right" x:Name="BtnImport" Content="导入 .variant" />
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="HullColumn" Width="225" MinWidth="170" MaxWidth="420" />
        <ColumnDefinition x:Name="HullSplitColumn" Width="12" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border x:Name="HullSidebar" Background="White" CornerRadius="10" Padding="12" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <TextBlock Text="舰船目录" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,10" />
          <TextBox Grid.Row="1" x:Name="BoxHullSearch" ToolTip="按名称、ID 或来源筛选" Margin="0,0,0,8" />
          <ListBox Grid.Row="2" x:Name="HullList">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="{Binding Source}" FontSize="11" Foreground="#73839B" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="3" x:Name="LabCatalog" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,8,0,0" />
        </Grid>
      </Border>
      <GridSplitter x:Name="HullSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="#D8E2EE" Cursor="SizeWE" ToolTip="左右拖动调整目录宽度；拖到最窄可收起" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" />
      <Grid Grid.Column="2" x:Name="Workspace">
        <Grid x:Name="PreviewHost" Background="Transparent" ClipToBounds="True">
          <Canvas x:Name="PreviewSurface" IsHitTestVisible="True">
            <Viewbox x:Name="PreviewBox" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top">
              <Canvas x:Name="ShipCanvas" Width="400" Height="400" />
            </Viewbox>
          </Canvas>
          <TextBlock x:Name="LabSprite" Text="正在读取游戏数据…" Foreground="#73839B" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12" TextWrapping="Wrap" MaxWidth="350" IsHitTestVisible="False" />
        </Grid>
        <Button x:Name="BtnFit" Content="适应画布" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" />
        <Grid x:Name="OverlayRail" Width="330" HorizontalAlignment="Right" Margin="8,0,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Border x:Name="DataPanel" Background="#F9FFFFFF" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="9" Padding="10" VerticalAlignment="Top" Margin="0,0,0,10">
            <DockPanel LastChildFill="True">
              <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LabHull" Text="选择一艘舰船" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <Button Grid.Column="1" x:Name="BtnToggleData" Content="收起" Padding="6,2" Margin="0" />
              </Grid>
              <ScrollViewer x:Name="DataBody" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                  <TextBlock x:Name="LabHullDetail" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Visibility="Collapsed" />
                  <Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LabBudget" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <TextBlock x:Name="LabFlux" FontSize="12" Grid.Column="1" HorizontalAlignment="Right" />
                  </Grid>
                  <ProgressBar x:Name="OpBar" Height="3" Margin="0,5" Foreground="#2866DB" />
                  <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="护盾 DPS" Foreground="#73839B" />
                      <TextBlock x:Name="LabShieldDps" Text="0" FontSize="16" Foreground="#2866DB" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock Text="装甲 DPS" Foreground="#73839B" />
                      <TextBlock x:Name="LabArmorDps" Text="0" FontSize="16" Foreground="#AE6A24" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="结构 DPS" Foreground="#73839B" />
                      <TextBlock x:Name="LabHullDps" Text="0" FontSize="16" Foreground="#248362" FontWeight="SemiBold" />
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="LabDamageBasis" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" MaxHeight="16" />
                  <TextBlock x:Name="LabHullStats" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="LabDeployment" FontWeight="SemiBold" Margin="0,4" />
                  <Expander Header="配置与生成说明" Margin="0,2,0,0">
                    <StackPanel>
                      <TextBox x:Name="BoxName" Text="SSPCL 配装" ToolTip="配置名称" />
                      <WrapPanel Margin="0,6">
                        <TextBlock Text="通风" VerticalAlignment="Center" />
                        <TextBox x:Name="BoxVents" Width="48" Text="0" Margin="6,0,12,0" />
                        <TextBlock Text="电容" VerticalAlignment="Center" />
                        <TextBox x:Name="BoxCaps" Width="48" Text="0" Margin="6,0,0,0" />
                      </WrapPanel>
                      <TextBlock x:Name="LabExplanation" TextWrapping="Wrap" Foreground="#73839B" />
                    </StackPanel>
                  </Expander>
                  <Expander x:Name="HullDetailsExpander" Header="完整舰船数据" Margin="0,2,0,0">
                    <Grid Height="310">
                      <Grid Margin="0,10,0,0" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="船体基础数据（含皮肤覆盖）。船插、技能及 MOD 动态脚本的实战修正由游戏计算；下方保留全部源参数。" Foreground="#73839B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                          <StackPanel>
                            <TextBlock x:Name="LabHullDescription" TextWrapping="Wrap" Margin="0,0,0,12" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                            <ItemsControl x:Name="HullParameterList" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Border BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                      <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" />
                                      <TextBlock Text="{Binding Value}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                    </StackPanel>
                                  </Border>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Expander Header="完整船体/皮肤规格" Margin="0,12,0,0">
                              <TextBox x:Name="BoxHullSpec" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxHeight="320" FontFamily="Consolas" FontSize="11" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                            </Expander>
                          </StackPanel>
                        </ScrollViewer>
                      </Grid>
                    </Grid>
                  </Expander>
                  <TextBlock x:Name="LabStatus" Text="准备读取游戏数据…" Foreground="#73839B" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" MaxHeight="16" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
              </ScrollViewer>
            </DockPanel>
          </Border>
          <Border Grid.Row="1" x:Name="FittingPanel" Background="#F9FFFFFF" BorderBrush="#DCE4EE" BorderThickness="1" CornerRadius="9" Padding="10">
            <DockPanel>
              <Grid DockPanel.Dock="Top" Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="槽位与装配" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="BtnToggleFitting" Grid.Column="1" Content="收起" Padding="6,2" Margin="0" />
              </Grid>
              <TabControl x:Name="DetailTabs" BorderThickness="0" Background="Transparent">
                <TabItem Header="槽位 / 武器" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <Grid Margin="0,6,0,0">
 <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
 <Expander Header="槽位目录"><ListBox x:Name="SlotList" FontSize="12" Height="95" /></Expander>
 <Grid Grid.Row="1" Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="LabSlot" TextWrapping="Wrap" FontWeight="SemiBold" /><CheckBox x:Name="CheckPin" Grid.Column="1" Content="锁定" ToolTip="生成时保留该槽位" VerticalAlignment="Center" Margin="8,0,0,0" /></Grid>
 <TextBox x:Name="BoxWeaponSearch" Grid.Row="2" ToolTip="搜索兼容武器，双击安装" Margin="0,0,0,4" />
 <StackPanel Grid.Row="3">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
  <ComboBox x:Name="FilterDamage" ToolTip="伤害类型" Margin="0,0,4,0" /><ComboBox x:Name="FilterSource" Grid.Column="1" ToolTip="来源 MOD" Margin="0,0,4,0" /><Button x:Name="BtnResetFilters" Grid.Column="2" Content="重置" Padding="6,3" Margin="0" />
 </Grid>
 <Expander Header="更多筛选" Margin="0,4"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><ComboBox x:Name="FilterSize" Margin="0,0,4,4" /><ComboBox x:Name="FilterType" Grid.Column="1" Margin="0,0,0,4" /><ComboBox x:Name="FilterFeature" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,4" /><TextBlock Grid.Row="2" Text="最大 OP" /><TextBlock Grid.Row="2" Grid.Column="1" Text="最低射程" /><TextBox x:Name="FilterMaxOp" Grid.Row="3" ToolTip="最大 OP，留空不限" Margin="0,0,4,0" /><TextBox x:Name="FilterMinRange" Grid.Row="3" Grid.Column="1" ToolTip="最低射程，留空不限" /></Grid></Expander>
 <TextBlock x:Name="LabWeaponCount" FontSize="11" Foreground="#73839B" Margin="0,0,0,4" />
 </StackPanel>
 <ListBox x:Name="WeaponList" Grid.Row="4" MinHeight="80" ItemContainerStyle="{StaticResource WeaponRowStyle}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding Display}" FontSize="10" Foreground="#73839B" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding Source}" Foreground="#73839B" FontSize="10" /></StackPanel></DataTemplate></ListBox.ItemTemplate><ListBox.ContextMenu><ContextMenu><MenuItem Header="加入对比 A" Click="AddCompareA" /><MenuItem Header="加入对比 B" Click="AddCompareB" /></ContextMenu></ListBox.ContextMenu></ListBox>
 <TextBlock x:Name="LabWeapon" Grid.Row="5" FontSize="11" Foreground="#73839B" TextTrimming="CharacterEllipsis" Margin="0,4" />
 <WrapPanel Grid.Row="6"><Button x:Name="BtnInstall" Content="安装武器" Background="#2866DB" Foreground="White" /><Button x:Name="BtnClear" Content="清空槽位" /><Button x:Name="BtnCompareA" Content="对比 A" /><Button x:Name="BtnCompareB" Content="对比 B" Margin="0" /></WrapPanel>
</Grid>
                </TabItem>
                <TabItem Header="武器对比" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <Grid Margin="0,6,0,0">
 <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
 <StackPanel><TextBox x:Name="BoxCompareSearch" ToolTip="搜索对比候选武器" Margin="0,0,0,6" /><Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><ComboBox x:Name="CompareA" DisplayMemberPath="Name" ToolTip="武器 A" Margin="0,0,4,0" /><ComboBox x:Name="CompareB" Grid.Column="1" DisplayMemberPath="Name" ToolTip="武器 B" /></Grid></StackPanel>
 <StackPanel Grid.Row="1" Margin="0,6"><WrapPanel><Button x:Name="BtnCompareSwap" Content="交换" /><Button x:Name="BtnCompareClear" Content="清空" Margin="0" /></WrapPanel><TextBlock x:Name="LabCompareFit" Foreground="#73839B" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel>
 <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel>
  <ItemsControl x:Name="CompareRows"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#E7EDF5" BorderThickness="0,0,0,1" Padding="0,6"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><TextBlock Text="{Binding Left}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{Binding Right}" TextWrapping="Wrap" Foreground="#2866DB" /></Grid><TextBlock Text="{Binding Difference}" FontSize="11" Foreground="#73839B" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Expander Header="描述与完整源参数" Margin="0,8"><TextBox x:Name="BoxCompareDescriptions" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="360" VerticalScrollBarVisibility="Auto" /></Expander>
 </StackPanel></ScrollViewer>
</Grid>
                </TabItem>
                <TabItem Header="船插" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,10,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Grid.Row="0" Margin="0,0,0,5">
 <ComboBox x:Name="HullModKind" SelectedIndex="0"><ComboBoxItem Content="普通与内置船插" /><ComboBoxItem Content="D 插" /><ComboBoxItem Content="全部船插" /></ComboBox>
 <CheckBox x:Name="CheckDerelict" Content="预览废船行动技能部署减免" IsChecked="True" Margin="0,6" ToolTip="0.98：每项 D 插减少 6% 部署点，最多5项；不写入角色技能或存档。" />
</StackPanel>
                      <TextBlock Text="普通船插占用 OP；内置/S 插不设数量上限。玩家决定添加，不自动限制适用性或冲突。" TextWrapping="Wrap" FontSize="11" Foreground="#73839B" Margin="0,0,0,8" Visibility="Collapsed" />
                      <TextBox Grid.Row="1" x:Name="BoxHullModSearch" ToolTip="搜索所有原版与已启用 MOD 船插" Margin="0,0,0,8" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                      <ListBox Grid.Row="2" x:Name="HullModList" Height="110" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#73839B" />
                              <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#73839B" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                      <ScrollViewer Grid.Row="3" MaxHeight="145" VerticalScrollBarVisibility="Auto" Margin="0,8">
                        <TextBlock x:Name="LabHullModDescription" Text="选择船插查看说明与当前舰型 OP。" TextWrapping="Wrap" FontSize="11" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                      </ScrollViewer>
                      <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button x:Name="BtnHullModNormal" Content="普通安装" Padding="9,7" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                        <Button x:Name="BtnHullModBuiltIn" Content="内置/S 插" Padding="9,7" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                        <Button x:Name="BtnHullModRemove" Content="移除" Padding="9,7" Margin="0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                        <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="BtnHullModD" Content="添加 D 插" Padding="6,6" Margin="4,0,0,0" />
                      </StackPanel>
                      <ListBox Grid.Row="5" x:Name="InstalledHullModList" FontSize="11" Height="110" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                      <TextBlock Grid.Row="6" x:Name="LabHullModCount" FontSize="11" Foreground="#73839B" TextWrapping="Wrap" Margin="0,8,0,0" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" />
                    </Grid>
                  </ScrollViewer>
                </TabItem>
              </TabControl>
            </DockPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
