<Window x:Class="Sspcl.App.Views.ModEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备注与分组" SizeToContent="WidthAndHeight" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg.Surface}"
        FontFamily="Microsoft YaHei UI, Segoe UI" MinWidth="420">
    <StackPanel Margin="22">
        <TextBlock Text="备注" FontSize="13" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
        <TextBox x:Name="NoteBox" Style="{StaticResource SearchBoxStyle}" MinWidth="376" Height="60"
                 TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
        <TextBlock Text="分组 / 标签（用逗号分隔，如：势力, 船包, 前置库）" FontSize="13"
                   Foreground="{StaticResource Text.Secondary}" Margin="0,12,0,6"/>
        <TextBox x:Name="TagsBox" Style="{StaticResource SearchBoxStyle}" MinWidth="376"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="保存" Style="{StaticResource PrimaryButton}" Click="Save_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
