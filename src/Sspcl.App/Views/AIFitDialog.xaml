<Window x:Class="Sspcl.App.Views.AIFitDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 配装" Height="680" Width="780" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg.Base}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- API 配置 -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="API 配置" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EndpointBox" Style="{StaticResource SearchBoxStyle}" Margin="0,0,8,0" ToolTip="API 地址（完整，含 /chat/completions）"/>
                <TextBox x:Name="KeyBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Margin="0,0,8,0" ToolTip="API Key"/>
                <Button Grid.Column="2" Content="保存配置" Style="{StaticResource SecondaryButton}" Click="SaveConfig_Click"/>
            </Grid>
            <TextBox x:Name="ModelBox" Style="{StaticResource SearchBoxStyle}" Margin="0,8,0,0" ToolTip="模型名称"/>
        </StackPanel>

        <!-- 数据状态 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock x:Name="StatusText" FontSize="12" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center"/>
            <Button Content="重新读取舰船/武器" Style="{StaticResource TextButton}" Margin="12,0,0,0" Click="Rescan_Click"/>
        </StackPanel>

        <!-- 输入 -->
        <TextBlock Grid.Row="2" Text="配装需求" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,14,0,6"/>
        <TextBox Grid.Row="3" x:Name="InputBox" Style="{StaticResource SearchBoxStyle}" AcceptsReturn="True" TextWrapping="Wrap"
                 MinHeight="72" VerticalScrollBarVisibility="Auto" ToolTip="例如：给攻势级配一套反盾近战，兼顾点防御"/>

        <Button Grid.Row="4" x:Name="GenerateBtn" Content="生成配装" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="Generate_Click"/>

        <!-- 输出 -->
        <TextBox Grid.Row="5" x:Name="OutputBox" IsReadOnly="True" FontSize="12" AcceptsReturn="True" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"
                 Background="{StaticResource Bg.SurfaceAlt}" Foreground="{StaticResource Text.Primary}"
                 BorderBrush="{StaticResource Border.Subtle}" Padding="8"/>
    </Grid>
</Window>
