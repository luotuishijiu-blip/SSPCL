<UserControl x:Class="Sspcl.App.Views.ModPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ModItemTemplate">
            <Border Style="{StaticResource CardStyle}" Width="232" Margin="0,0,10,10" Padding="12,10" Loaded="ModTile_Loaded">
                <Border.ToolTip>
                    <StackPanel MaxWidth="520">
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                        <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource Text.Tertiary}"/>
                        <TextBlock Text="{Binding Authors, StringFormat='作者：{0}'}" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0"/>
                        <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding GameVersion, StringFormat='游戏版本 {0}'}" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding DepsText}" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="240"/>
                    </StackPanel>
                </Border.ToolTip>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                  VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="{Binding FavoriteGlyph}" Style="{StaticResource TextButton}"
                                Foreground="{Binding FavoriteBrush}" Tag="{Binding}" Click="Favorite_Click" ToolTip="收藏 / 取消收藏"/>
                    </Grid>
                    <TextBlock Text="{Binding Id}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Text.Tertiary}"
                               TextTrimming="CharacterEllipsis" Margin="26,3,0,0"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{Binding StatusBrush}" Margin="26,4,0,0"/>
                    <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="26,3,0,0"/>
                    <TextBlock Text="{Binding GameVersion, StringFormat='游戏 {0}'}" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="26,1,0,0"/>
                    <TextBlock Text="{Binding DepsText}" FontSize="10" Foreground="{StaticResource Text.Tertiary}"
                               Margin="26,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="24"/>
                    <TextBlock Text="{Binding ProblemText}" FontSize="11" Foreground="{StaticResource State.ErrorText}"
                               Margin="26,4,0,0" TextWrapping="Wrap" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}"/>
                    <TextBlock Text="{Binding NoteText}" FontSize="11" Foreground="{StaticResource Accent.Warm}"
                               Margin="26,4,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"/>
                    <StackPanel Orientation="Horizontal" Margin="26,6,0,0">
                        <Button Content="备注" Style="{StaticResource TextButton}" Tag="{Binding}" Click="Note_Click"/>
                        <Button Content="删除" Style="{StaticResource TextButton}" Foreground="{StaticResource State.ErrorText}"
                                Tag="{Binding}" Click="Delete_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="25,12,25,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 头部 -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Mod 管理" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
            <TextBlock x:Name="HeaderSub" FontSize="12" Foreground="{StaticResource Text.Tertiary}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- 搜索 + 工具栏 -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBoxStyle}" TextChanged="SearchBox_TextChanged"
                     ToolTip="搜索 mod 名称 / id / 作者 / 前置 / 备注 / 分组"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="导入列表" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ImportList_Click"/>
                <Button Content="导出列表" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="ExportList_Click"/>
                <Button Content="还原备份" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="Restore_Click"/>
                <Button Content="重新扫描" Style="{StaticResource SecondaryButton}" Click="Rescan_Click"/>
            </StackPanel>
        </Grid>

        <!-- 筛选 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton Content="全部" GroupName="Filter" IsChecked="True" Checked="Filter_Checked" Tag="all"
                         Style="{StaticResource FilterRadioStyle}" Margin="0,0,6,0"/>
            <RadioButton Content="已启用" GroupName="Filter" Checked="Filter_Checked" Tag="enabled"
                         Style="{StaticResource FilterRadioStyle}" Margin="0,0,6,0"/>
            <RadioButton Content="已禁用" GroupName="Filter" Checked="Filter_Checked" Tag="disabled"
                         Style="{StaticResource FilterRadioStyle}" Margin="0,0,6,0"/>
            <RadioButton Content="有问题" GroupName="Filter" Checked="Filter_Checked" Tag="problem"
                         Style="{StaticResource FilterRadioStyle}" Margin="0,0,6,0"/>
            <RadioButton Content="收藏" GroupName="Filter" Checked="Filter_Checked" Tag="favorite"
                         Style="{StaticResource FilterRadioStyle}"/>
        </StackPanel>

        <!-- 依赖/兼容性概要 + 批量操作 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="12,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SummaryText" Foreground="{StaticResource Text.Secondary}" FontSize="12"
                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <CheckBox x:Name="HideWarningsBox" Content="不再显示警告" Style="{StaticResource DarkCheckBox}"
                              Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,10,0"
                              Checked="HideWarnings_Changed" Unchecked="HideWarnings_Changed"/>
                    <Button Content="启用当前列表" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"
                            Click="EnableVisible_Click" ToolTip="启用当前筛选/搜索出的全部 mod"/>
                    <Button Content="禁用当前列表" Style="{StaticResource SecondaryButton}"
                            Click="DisableVisible_Click" ToolTip="禁用当前筛选/搜索出的全部 mod"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Mod 列表（平铺卡片） -->
        <ListBox Grid.Row="5" x:Name="ModList" Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource ModItemTemplate}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <TextBlock Grid.Row="6" x:Name="StatusBar" Foreground="{StaticResource Text.Tertiary}" FontSize="12" Margin="0,8,0,0"/>
    </Grid>
</UserControl>
