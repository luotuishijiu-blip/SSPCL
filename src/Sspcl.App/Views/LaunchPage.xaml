<UserControl x:Class="Sspcl.App.Views.LaunchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="FolderItemTemplate">
            <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{StaticResource Text.Primary}"/>
                <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="VersionCardTemplate">
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,10" Padding="16,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21" Background="{StaticResource Accent.Dim}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}" FontSize="18" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="{Binding Version, StringFormat=' · {0}'}" FontSize="12" Foreground="{StaticResource Accent.Warm}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource Text.Tertiary}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="当前" FontSize="12" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center"
                                   Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" Margin="0,0,10,0"/>
                        <Button Content="设置" Style="{StaticResource TextButton}" Tag="{Binding}" Click="OpenInstallSettings_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ConfigFieldTemplate">
            <Border Style="{StaticResource CardStyle}" Width="240" Margin="0,0,10,10" Padding="0">
                <StackPanel>
                    <Button Tag="{Binding}" Click="ConfigFieldHeader_Click" Style="{StaticResource TextButton}"
                            HorizontalContentAlignment="Stretch" Padding="10,8" Cursor="Hand">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding SubLabel}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Text.Tertiary}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ExpandGlyph}" FontSize="12" Foreground="{StaticResource Accent.Primary}" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <StackPanel Margin="10,0,10,10" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Note}" FontSize="10" Foreground="{StaticResource Text.Tertiary}" TextWrapping="Wrap"
                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" Margin="0,4,0,6"/>
                        <CheckBox Content="启用" Style="{StaticResource DarkCheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Visibility="{Binding IsBool, Converter={StaticResource BoolToVis}}"/>
                        <TextBox Style="{StaticResource SearchBoxStyle}" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding ShowText, Converter={StaticResource BoolToVis}}" ToolTip="{Binding Note}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- 主视图 -->
        <Grid x:Name="MainView">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,1,0" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                <!-- 启动方式切换（正版/离线 的映射） -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DirectLaunchRadio" Content="直接启动" GroupName="LaunchMode" Tag="direct"
                                 Style="{StaticResource FilterRadioStyle}" HorizontalContentAlignment="Center" Checked="LaunchMode_Checked" Margin="0,0,4,0"/>
                    <RadioButton x:Name="GameLauncherRadio" Content="自带启动器" GroupName="LaunchMode" Tag="launcher"
                                 Style="{StaticResource FilterRadioStyle}" Grid.Column="1" HorizontalContentAlignment="Center" Checked="LaunchMode_Checked" Margin="4,0,0,0"/>
                </Grid>

                <!-- 用户信息 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Border Width="78" Height="78" CornerRadius="39" Background="{StaticResource Accent.Gradient}" HorizontalAlignment="Center">
                        <TextBlock Text="SS" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="AccountName" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock x:Name="AccountVersion" FontSize="12" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="2">
                    <Button x:Name="LaunchBtn" Style="{StaticResource BorderedLaunchButton}" Click="Launch_Click">
                        <StackPanel>
                            <TextBlock Text="启动游戏" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Accent.Primary}" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="LaunchBtnSub" FontSize="11" Foreground="{StaticResource Text.Tertiary}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Button>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="版本选择" Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Click="ShowVersionSelect_Click"/>
                        <Button Content="版本设置" Style="{StaticResource SecondaryButton}" Grid.Column="1" Margin="5,0,0,0" Click="OpenCurrentInstallSettings_Click"/>
                    </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
                    <ItemsControl x:Name="PinnedTools">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                                    <Button Content="{Binding Name}" Style="{StaticResource SecondaryButton}" Tag="{Binding}" Click="PinnedTool_Click" ToolTip="{Binding Path}"/>
                                    <Button Content="×" Style="{StaticResource TextButton}" Tag="{Binding}" Click="UnpinTool_Click" ToolTip="取消部署"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="＋" Style="{StaticResource PrimaryButton}" Width="40" Height="40" FontSize="18" FontWeight="Bold" Click="AddPin_Click" ToolTip="从百宝箱部署工具到主页"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 版本选择视图 -->
        <Grid x:Name="VersionSelectView" Visibility="Collapsed" Background="{StaticResource Bg.Base}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="← 返回" Style="{StaticResource TextButton}" FontSize="14"
                            Foreground="{StaticResource Accent.Primary}" Click="Back_Click"/>
                    <TextBlock Grid.Column="1" Text="版本选择" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Width="60"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardStyle}" Padding="16,14">
                        <StackPanel>
                            <TextBlock Text="文件夹列表" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <ListBox x:Name="FolderList" Background="Transparent" BorderThickness="0" Margin="0,8,0,0"
                                     ItemTemplate="{StaticResource FolderItemTemplate}">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,6"/>
                                        <Setter Property="Margin" Value="0,1"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Hover}"/></Trigger>
                                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Selected}"/></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="添加或导入" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <Button Content="＋ 添加游戏目录" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="AddFolder_Click"/>
                            <Button Content="⬇ 导入 Mod 压缩包" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0" Click="ImportArchive_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <ListBox Grid.Column="1" x:Name="VersionCardList" Background="Transparent" BorderThickness="0" Margin="20,0,0,0"
                         ItemTemplate="{StaticResource VersionCardTemplate}" SelectionChanged="VersionCardList_SelectionChanged"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Hover}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 版本设置视图 -->
        <Grid x:Name="InstallSettingsView" Visibility="Collapsed" Background="{StaticResource Bg.Base}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Background="{StaticResource Bg.Surface}" BorderBrush="{StaticResource Border.Subtle}" BorderThickness="0,0,0,1" Padding="16,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="← 返回" Style="{StaticResource TextButton}" FontSize="14"
                            Foreground="{StaticResource Accent.Primary}" Click="SettingsBack_Click"/>
                    <TextBlock Grid.Column="1" x:Name="SettingsTitle" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Width="60"/>
                </Grid>
            </Border>
            <Grid Grid.Row="1" Margin="24,20,24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="SettingsCategoryList" Background="Transparent" BorderThickness="0" SelectionChanged="SettingsCategory_Changed">
                    <ListBoxItem Content="设置"/>
                    <ListBoxItem Content="概览"/>
                    <ListBoxItem Content="Mod 管理"/>
                    <ListBoxItem Content="配置文件"/>
                    <ListBoxItem Content="日志"/>
                    <ListBoxItem Content="导出"/>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="Margin" Value="0,1"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Hover}"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Selected}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Grid Grid.Column="1" Margin="16,0,0,0">
                    <!-- 设置 -->
                    <StackPanel x:Name="InstallSettingsPanel">
                        <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="内存分配" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="默认跟随全局设置；可在此为当前版本单独自定义。" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="0,4,0,10"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <RadioButton x:Name="MemFollowGlobalRadio" Content="跟随全局设置" GroupName="InstMemMode" Tag="global" Style="{StaticResource FilterRadioStyle}" Checked="InstMemMode_Checked" Margin="0,0,6,0"/>
                                    <RadioButton x:Name="MemCustomRadio" Content="自定义" GroupName="InstMemMode" Tag="custom" Style="{StaticResource FilterRadioStyle}" Checked="InstMemMode_Checked"/>
                                </StackPanel>
                                <StackPanel x:Name="InstMemCustomPanel" Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="-Xmx (MB)" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="InstXmxBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="-Xms (MB)" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                        <TextBox x:Name="InstXmsBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Button Content="保存内存" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveMemory_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="备注 / 自定义信息" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBox x:Name="NoteBox" Style="{StaticResource SearchBoxStyle}" MinHeight="60" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto" Margin="0,12,0,0"/>
                                <Button Content="保存备注" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="SaveNote_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- 概览 -->
                    <StackPanel x:Name="InstallOverviewPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="概览" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock x:Name="InstallOverviewText" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- Mod 管理 -->
                    <ContentControl x:Name="InstallModPanel" Visibility="Collapsed"/>
                    <!-- 导出 -->
                    <StackPanel x:Name="InstallExportPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" Padding="18,16">
                            <StackPanel>
                                <TextBlock Text="Mod 列表" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                                <TextBlock Text="导出该版本当前启用的 Mod id 清单（不含 Mod 本体）。" FontSize="12" Foreground="{StaticResource Text.Tertiary}" Margin="0,6,0,12"/>
                                <Button Content="复制 Mod 清单到剪贴板" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ExportClipboard_Click"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <!-- 日志 -->
                    <StackPanel x:Name="InstallLogPanel" Visibility="Collapsed">
                        <Border Style="{StaticResource CardStyle}" Padding="14,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="InstallLogFilter" Style="{StaticResource SearchBoxStyle}" Width="240" TextChanged="InstallLog_Changed" ToolTip="过滤关键字"/>
                                    <CheckBox x:Name="InstallLogErrors" Content="仅错误" Style="{StaticResource DarkCheckBox}" Foreground="{StaticResource Text.Secondary}"
                                              VerticalAlignment="Center" Margin="12,0,0,0" Checked="InstallLog_Changed" Unchecked="InstallLog_Changed"/>
                                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Click="InstallLogRefresh_Click"/>
                                </StackPanel>
                                <TextBox Grid.Row="1" x:Name="InstallLogText" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                                         TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                         Background="{StaticResource Bg.SurfaceAlt}" Foreground="{StaticResource Text.Primary}"
                                         BorderBrush="{StaticResource Border.Subtle}" Padding="8" MinHeight="300"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <!-- 配置文件 -->
                    <Grid x:Name="InstallConfigPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ConfigSearch" Style="{StaticResource SearchBoxStyle}" TextChanged="ConfigSearch_TextChanged" ToolTip="按中文名或英文名搜索设置项"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,0,6,0" Click="ConfigSave_Click"/>
                                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Click="ConfigRefresh_Click"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1" x:Name="ConfigPathText" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,0,8" TextTrimming="CharacterEllipsis"/>
                        <ListBox Grid.Row="2" x:Name="ConfigFieldList" Background="Transparent" BorderThickness="0"
                                 ItemTemplate="{StaticResource ConfigFieldTemplate}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
