<Window x:Class="Sspcl.App.Views.ToolEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="工具" Height="340" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Bg.Base}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="名称" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Style="{StaticResource SearchBoxStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="程序 / 文件路径" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="PathBox" Style="{StaticResource SearchBoxStyle}"/>
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Browse_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="参数（可选）" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <TextBox x:Name="ArgsBox" Style="{StaticResource SearchBoxStyle}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Text="工作目录（可选）" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,0,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="WorkDirBox" Style="{StaticResource SearchBoxStyle}"/>
                <Button Grid.Column="1" Content="浏览…" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="WorkDirBrowse_Click"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="确定" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="Ok_Click"/>
            <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
