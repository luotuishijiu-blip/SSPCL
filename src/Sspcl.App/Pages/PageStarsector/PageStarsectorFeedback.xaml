<local:MyPageRight x:Class="PageStarsectorFeedback"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sspcl" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Title="反馈" Margin="0,0,0,15">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock Text="遇到问题或想提建议？填写后发送给开发者。" FontSize="14" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap"/>
                    <TextBlock Text="接收地址（Discord Webhook 或任意 POST 接口）" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,10,0,0"/>
                    <local:MyTextBox x:Name="UrlBox" Margin="0,6,0,0"/>
                    <TextBlock Text="反馈内容" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}" Margin="0,10,0,0"/>
                    <local:MyTextBox x:Name="BoxFeedback" Margin="0,6,0,0" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <local:MyButton x:Name="BtnSend" Text="发送反馈" Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
