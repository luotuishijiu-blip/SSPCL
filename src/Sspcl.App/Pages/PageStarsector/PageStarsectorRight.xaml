<local:MyPageRight x:Class="PageStarsectorRight"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sspcl" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
            <StackPanel x:Name="PanMain" Margin="25,25,25,10">
                <TextBlock Text="快捷方式" FontSize="14" Foreground="{DynamicResource ColorBrush1}" Margin="0,0,0,12"/>
                <WrapPanel x:Name="PanShortcuts"/>
            </StackPanel>
        </local:MyScrollViewer>
        <Border x:Name="BtnAddShortcut" Width="40" Height="40" CornerRadius="20"
                Background="{DynamicResource ColorBrush2}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,24,24" Cursor="Hand" ToolTip="添加快捷方式">
            <TextBlock Text="+" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" IsHitTestVisible="False"/>
        </Border>
    </Grid>
</local:MyPageRight>
