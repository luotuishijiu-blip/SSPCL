<local:MyPageRight x:Class="PageStarsectorToolbox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sspcl" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <local:MyCard Title="百宝箱" Margin="0,0,0,15">
                <StackPanel Margin="20,38,20,18">
                    <TextBlock Text="运行玩家加入的自制工具" FontSize="14" Foreground="{DynamicResource ColorBrush1}"/>
                    <local:MyButton x:Name="BtnAddTool" Text="添加工具" Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    <StackPanel x:Name="PanToolList" Margin="0,12,0,0"/>
                </StackPanel>
            </local:MyCard>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
