<local:MyPageRight x:Class="PageStarsectorSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Sspcl" PanScroll="PanBack">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" x:Name="PanBack">
        <StackPanel x:Name="PanMain" Margin="25,25,25,10">
            <!-- 启动 -->
            <StackPanel x:Name="PanLaunch">
                <local:MyCard Title="内存分配" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <StackPanel Orientation="Horizontal">
                            <local:MyRadioButton x:Name="RbRamAuto" Text="自动配置" Tag="auto" ColorType="Highlight" Margin="0,0,14,0"/>
                            <local:MyRadioButton x:Name="RbRamCustom" Text="自定义" Tag="custom" ColorType="Highlight"/>
                        </StackPanel>
                        <local:MySlider x:Name="SliderRam" MaxValue="49" Value="8" IsEnabled="False" Margin="0,12,0,0"/>
                        <local:MyCheckBox x:Name="ChkRamOptimize" Text="启动游戏前进行内存优化" Margin="0,14,0,0"/>
                        <Grid x:Name="PanRamBar" Height="14" Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="ColRamUsed" Width="1*"/>
                                <ColumnDefinition x:Name="ColRamGame" Width="1*"/>
                                <ColumnDefinition x:Name="ColRamFree" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="RectRamUsed" Grid.Column="0" StrokeThickness="0" RadiusX="2" RadiusY="2" Fill="{DynamicResource ColorBrushGray4}"/>
                            <Rectangle x:Name="RectRamGame" Grid.Column="1" StrokeThickness="0" RadiusX="2" RadiusY="2" Fill="{DynamicResource ColorBrush3}" Opacity="0.5"/>
                            <Rectangle x:Name="RectRamFree" Grid.Column="2" StrokeThickness="0" RadiusX="2" RadiusY="2" Fill="{DynamicResource ColorBrush6}" Opacity="0.7"/>
                        </Grid>
                        <TextBlock x:Name="LabRamInfo" FontSize="12" Foreground="{DynamicResource ColorBrush1}" Margin="0,8,0,0"/>
                    </StackPanel>
                </local:MyCard>
                <local:MyCard Title="启动选项" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <local:MyCheckBox x:Name="ChkSkipLauncher" Text="跳过游戏自带启动器（直接启动）"/>
                        <local:MyCheckBox x:Name="ChkCloseAfterLaunch" Text="启动游戏后关闭启动器" Margin="0,8,0,0"/>
                        <local:MyCheckBox x:Name="ChkHighPriority" Text="高优先级进程" Margin="0,8,0,0"/>
                        <local:MyCheckBox x:Name="ChkWarmStart" Text="热启动优化（AppCDS 类数据共享，加速启动）" Margin="0,8,0,0"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,6,0,0" Text="首次启动会生成 starsector.jsa 归档（稍慢），之后启动直接加载归档加速类加载。"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <TextBlock Text="窗口宽" VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <local:MyTextBox x:Name="BoxWinW" Width="80" Margin="8,0,0,0"/>
                            <TextBlock Text="窗口高" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{DynamicResource ColorBrushGray3}"/>
                            <local:MyTextBox x:Name="BoxWinH" Width="80" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock FontSize="12" Foreground="{DynamicResource ColorBrushGray4}" TextWrapping="Wrap" Margin="0,6,0,0" Text="窗口宽高留空或 0 表示使用游戏默认。"/>
                    </StackPanel>
                </local:MyCard>
                <local:MyCard Title="高级选项" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock Text="虚拟机参数（追加到 java.exe 参数，如 -XX:+UseG1GC）" FontSize="12" Foreground="{DynamicResource ColorBrushGray3}"/>
                        <local:MyTextBox x:Name="BoxVmArgs" Margin="0,8,0,0"/>
                    </StackPanel>
                </local:MyCard>
                <local:MyCard Title="配置文件" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <StackPanel Orientation="Horizontal">
                            <local:MyButton x:Name="BtnOpenSettingsJson" Text="settings.json" Padding="14,6"/>
                            <local:MyButton x:Name="BtnOpenVmparams" Text="vmparams" Padding="14,6" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </local:MyCard>
                <local:MyCard Title="版本独立设置" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock FontSize="13" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap" Text="Mod 管理、概览、导出等针对当前版本的设置。"/>
                        <local:MyButton x:Name="BtnOpenInstanceSetup" Text="打开版本设置" Padding="14,6" Margin="0,12,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <!-- 个性化 -->
            <StackPanel x:Name="PanUI" Visibility="Collapsed">
                <local:MyCard Title="个性化" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <TextBlock FontSize="13" Foreground="{DynamicResource ColorBrush1}" TextWrapping="Wrap"
                                   Text="sspcl 沿用 Sspcl 原版浅色主题（白色左侧栏 + 浅蓝右侧 + 深灰文字），暂不开放主题切换。"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
            <!-- 其他 -->
            <StackPanel x:Name="PanSystem" Visibility="Collapsed">
                <local:MyCard Title="其他" Margin="0,0,0,15">
                    <StackPanel Margin="20,38,20,18">
                        <local:MyButton x:Name="BtnOpenGameDir" Text="打开游戏目录" Padding="14,6" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <local:MyButton x:Name="BtnOpenModPool" Text="打开 mod 池" Padding="14,6" Margin="0,0,0,10" HorizontalAlignment="Left"/>
                        <local:MyButton x:Name="BtnOpenLog" Text="打开日志" Padding="14,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageRight>
