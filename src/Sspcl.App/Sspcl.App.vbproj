  <ItemGroup>

  </ItemGroup>
  <!-- Legacy executable embeds Core via Resources.resx; always refresh it from the source project. -->
  <Target Name="BuildCoreForLegacyApp" BeforeTargets="PrepareForBuild"
          Condition="'$(MSBuildProjectName)' == 'Sspcl.App'">
    <MSBuild Projects="..\Sspcl.Core\Sspcl.Core.csproj"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0" />
    <Copy SourceFiles="..\Sspcl.Core\bin\$(Configuration)\netstandard2.0\Sspcl.Core.dll"
          DestinationFiles="Resources\Sspcl.Core.dll"
          SkipUnchangedFiles="true" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!-- Build byte-only resources without ResX type deserialization. Keep the designer source. -->
  <Target Name="CompileByteResources" BeforeTargets="PrepareResources"
          DependsOnTargets="BuildCoreForLegacyApp;ResolveProjectReferences"
          Condition="'$(MSBuildProjectName)' == 'Sspcl.App'">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\eng\compile-legacy-resources.ps1&quot; -ProjectDirectory &quot;$(MSBuildProjectDirectory)&quot; -OutputFile &quot;$(IntermediateOutputPath)Sspcl.Resources.resources&quot;" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)Sspcl.Resources.resources" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <Page Include="Features\Starsector\Loadouts\LoadoutWorkbench.xaml"><Generator>MSBuild:Compile</Generator><SubType>Designer</SubType></Page>
    <Compile Include="Features\Starsector\Loadouts\LoadoutWorkbench.xaml.vb"><DependentUpon>LoadoutWorkbench.xaml</DependentUpon></Compile>
    <Compile Include="Features\Starsector\Loadouts\LoadoutWorkbench.Rendering.vb" />
    <Compile Include="Features\Starsector\Loadouts\LoadoutWorkbench.Details.vb" />
    <Compile Include="Features\Starsector\Loadouts\LoadoutWorkbench.Inspection.vb" />
  </ItemGroup>
</Project>
