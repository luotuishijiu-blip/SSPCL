<UserControl x:Class="Sspcl.Desktop.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <DataTemplate x:Key="ToolTemplate">
            <Border Style="{StaticResource CardStyle}" Width="250" Margin="0,0,10,10" Padding="12,10">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Path}" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Text.Tertiary}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="运行" Style="{StaticResource PrimaryButton}" Tag="{Binding}" Click="Run_Click" Margin="0,0,8,0"/>
                        <Button Content="编辑" Style="{StaticResource TextButton}" Tag="{Binding}" Click="Edit_Click"/>
                        <Button Content="删除" Style="{StaticResource TextButton}" Foreground="{StaticResource State.ErrorText}" Tag="{Binding}" Click="Delete_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="25,12,25,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="百宝箱" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                <TextBlock Text="添加并运行你自己的工具；可在主页右下角用 ＋ 部署到主页。" FontSize="12" Foreground="{StaticResource Text.Tertiary}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="AI 配装" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="AIFit_Click"/>
                <Button Content="添加工具" Style="{StaticResource SecondaryButton}" Click="Add_Click"/>
            </StackPanel>
        </Grid>
        <ListBox Grid.Row="1" x:Name="ToolList" Background="Transparent" BorderThickness="0"
                 ItemTemplate="{StaticResource ToolTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Top"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>
    </Grid>
</UserControl>
