<UserControl x:Class="Sspcl.Desktop.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="25,12,25,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左栏：设置分类 -->
        <StackPanel Grid.Column="0">
            <Border Style="{StaticResource CardStyle}" Padding="12,12">
                <StackPanel>
                    <TextBlock Text="设置" FontSize="12" Foreground="{StaticResource Text.Tertiary}"/>
                    <ListBox x:Name="CategoryList" Background="Transparent" BorderThickness="0" Margin="0,8,0,0" SelectionChanged="Category_Changed">
                        <ListBoxItem Content="启动"/>
                        <ListBoxItem Content="个性化"/>
                        <ListBoxItem Content="其他"/>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,7"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Hover}"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource Bg.Selected}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- 右栏：设置卡片 -->
        <ScrollViewer Grid.Column="1" Margin="16,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 启动 -->
                <StackPanel x:Name="LaunchPanel">
                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="启动选项" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="启动后行为" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="MinimizeRadio" Content="最小化到托盘" GroupName="Behavior" Tag="minimize" Style="{StaticResource FilterRadioStyle}" Checked="Behavior_Checked" Margin="0,0,6,0"/>
                                <RadioButton x:Name="KeepRadio" Content="保持不变" GroupName="Behavior" Tag="keep" Style="{StaticResource FilterRadioStyle}" Checked="Behavior_Checked"/>
                            </StackPanel>
                            <TextBlock Text="进程优先级" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,14,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="NormalRadio" Content="正常" GroupName="Priority" Tag="Normal" Style="{StaticResource FilterRadioStyle}" Checked="Priority_Checked" Margin="0,0,6,0"/>
                                <RadioButton x:Name="AboveNormalRadio" Content="高于正常" GroupName="Priority" Tag="AboveNormal" Style="{StaticResource FilterRadioStyle}" Checked="Priority_Checked" Margin="0,0,6,0"/>
                                <RadioButton x:Name="HighRadio" Content="高" GroupName="Priority" Tag="High" Style="{StaticResource FilterRadioStyle}" Checked="Priority_Checked"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="内存分配" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                                <RadioButton x:Name="MemAutoRadio" Content="自动配置" GroupName="MemMode" Style="{StaticResource FilterRadioStyle}" Checked="MemMode_Checked" Margin="0,0,6,0"/>
                                <RadioButton x:Name="MemCustomRadio" Content="自定义" GroupName="MemMode" Style="{StaticResource FilterRadioStyle}" Checked="MemMode_Checked"/>
                            </StackPanel>
                            <TextBlock x:Name="MemAutoHint" FontSize="11" Foreground="{StaticResource Text.Tertiary}" Margin="0,0,0,8"/>
                            <StackPanel x:Name="MemCustomPanel" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="-Xmx (MB)" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="GlobalXmxBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Margin="8,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="-Xms (MB)" FontSize="12" Foreground="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                                    <TextBox x:Name="GlobalXmsBox" Grid.Column="1" Style="{StaticResource SearchBoxStyle}" Margin="8,0,0,0"/>
                                </Grid>
                                <Button Content="保存" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Click="GlobalMemSave_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="MemText" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,8,0,6"/>
                            <ProgressBar x:Name="MemBar" Height="8" Foreground="{StaticResource Accent.Primary}" Background="{StaticResource Bg.SurfaceAlt}" BorderThickness="0"/>
                            <TextBlock x:Name="GameMemText" FontSize="12" Foreground="{StaticResource Text.Tertiary}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="高级选项" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="Java 虚拟机参数（vmparams）" FontSize="12" Foreground="{StaticResource Text.Secondary}" Margin="0,12,0,6"/>
                            <TextBox x:Name="VmparamsBox" FontFamily="Consolas" FontSize="12" AcceptsReturn="True" TextWrapping="NoWrap"
                                     HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                     Background="{StaticResource Bg.SurfaceAlt}" Foreground="{StaticResource Text.Primary}"
                                     BorderBrush="{StaticResource Border.Subtle}" Padding="8" MinHeight="120"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="VmparamsSave_Click"/>
                                <Button Content="刷新" Style="{StaticResource SecondaryButton}" Click="VmparamsRefresh_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 个性化 -->
                <StackPanel x:Name="PersonalizePanel" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="个性化" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock Text="主题：攻势级（当前）" FontSize="13" Foreground="{StaticResource Text.Secondary}" Margin="0,12,0,0"/>
                            <TextBlock Text="更多势力主题规划中（参考 TriOS 的 40 套势力主题）。" FontSize="12" Foreground="{StaticResource Text.Tertiary}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 其他 -->
                <StackPanel x:Name="OtherPanel" Visibility="Collapsed">
                    <Border Style="{StaticResource CardStyle}" Padding="18,16">
                        <StackPanel>
                            <TextBlock Text="关于" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text.Primary}"/>
                            <TextBlock x:Name="AboutText" FontSize="12" Foreground="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
