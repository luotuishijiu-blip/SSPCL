<local:MyPageLeft x:Class="PageStarsectorLeft"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:PCL"
             mc:Ignorable="d" x:Name="PanBack" Width="300">
    <Grid x:Name="PanInput" RenderTransformOrigin="0.5,0.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <!-- 顶部：启动模式切换（直接启动 / 启动器启动） -->
        <Grid Grid.Row="0" Margin="20,20,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <local:MyRadioButton x:Name="RbDirect" Grid.Column="1" Tag="direct" ColorType="Highlight" Text="直接启动" Margin="4,0" Checked="True" Padding="2,0"/>
            <local:MyRadioButton x:Name="RbLauncher" Grid.Column="2" Tag="launcher" ColorType="Highlight" Text="启动器启动" Margin="4,0" Padding="2,0"/>
        </Grid>
        <!-- 中部：舰船头像 + 游戏名（star 填充，居中） -->
        <StackPanel Grid.Row="1" Margin="20,0" VerticalAlignment="Center">
            <Border Width="72" Height="72" CornerRadius="36" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="Avatar_Click" ToolTip="点击更换舰船头像">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#D5E6FD" Offset="0"/>
                        <GradientStop Color="#96C0F9" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Image x:Name="ImgAvatar" Width="66" Height="66" Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="LabName" Text="远行星号" FontSize="14" Foreground="{DynamicResource ColorBrush1}" HorizontalAlignment="Center" Margin="0,12,0,0"/>
        </StackPanel>
        <!-- 底部：启动游戏（副标题叠加在按钮上） -->
        <Grid Grid.Row="2" Margin="20,0">
            <local:MyButton x:Name="BtnLaunch" Height="54" Text="启动游戏" ColorType="Highlight" Padding="30,0,30,15"/>
            <TextBlock x:Name="LabVersionSub" Text="0.98a-RC8 · 汉化" Margin="35,0,35,10" IsHitTestVisible="False" VerticalAlignment="Bottom" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource ColorBrushGray3}"/>
        </Grid>
        <!-- 版本选择（宽，1*）/ 版本设置（窄，带图标占位） -->
        <Grid Grid.Row="3" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:MyButton x:Name="BtnVersionSelect" Grid.Column="0" Height="35" Margin="0,10,10,0" Text="版本选择"/>
            <local:MyButton x:Name="BtnVersionSetup" Grid.Column="1" Height="35" Margin="0,10,0,0" TextPadding="36" Text="版本设置"/>
        </Grid>
    </Grid>
</local:MyPageLeft>
